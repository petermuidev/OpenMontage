{
  "schema_version": "2.0",
  "treatments": [
    {"treatment_id": "vibe-music-v1", "title": "Music-led atmosphere", "audio_modes": ["music"], "story_grammar": ["immediate visual hook", "rhythmic escalation", "clean closing image"], "hard_rejections": ["random cuts unrelated to music", "technically audible but emotionally ineffective music"]},
    {"treatment_id": "motivational-narration-v1", "title": "Motivational narrated story", "audio_modes": ["narration", "music"], "story_grammar": ["specific emotional hook", "short development", "earned landing line"], "hard_rejections": ["generic filler language", "spoken sentence without a supporting visual"]},
    {"treatment_id": "factual-venue-tour-v1", "title": "Factual venue introduction", "audio_modes": ["narration", "music"], "story_grammar": ["arrival or context", "verified spaces or experience", "truthful close"], "hard_rejections": ["unsupported facility or availability claim", "narration describes a scene that is not visible"]},
    {"treatment_id": "smooth-luxury-tour-v1", "title": "Smooth premium tour", "audio_modes": ["music", "optional-narration"], "story_grammar": ["calm opening", "spatial progression", "hero view or room close"], "hard_rejections": ["rapid cuts that destroy spatial understanding", "invented luxury claims"]},
    {"treatment_id": "fast-beat-montage-v1", "title": "Fast beat-led montage", "audio_modes": ["music"], "story_grammar": ["first-frame hook", "one-to-three-second visual changes", "loopable or decisive ending"], "hard_rejections": ["repeated near-identical frame", "cuts faster than subject readability"]},
    {"treatment_id": "pov-journey-v1", "title": "POV journey", "audio_modes": ["music", "optional-narration"], "story_grammar": ["arrival", "movement through space", "destination payoff"], "hard_rejections": ["false spatial continuity", "POV label on unrelated disconnected scenes"]},
    {"treatment_id": "countdown-listicle-v1", "title": "Countdown or listicle", "audio_modes": ["narration", "music", "text-only"], "story_grammar": ["clear list promise", "distinct supported items", "summary or choice close"], "hard_rejections": ["item lacks distinct evidence", "dense unreadable cards"]},
    {"treatment_id": "interactive-choice-v1", "title": "Comment-choice engagement", "audio_modes": ["music", "text-only"], "story_grammar": ["simple choice hook", "two-to-four distinct options", "one explicit response CTA"], "hard_rejections": ["options are visually indistinguishable", "more than one competing CTA"]},
    {"treatment_id": "commercial-offer-v1", "title": "Commercial offer and CTA", "audio_modes": ["music", "narration", "text-only"], "story_grammar": ["problem or desire", "specific truthful value", "one destination CTA"], "hard_rejections": ["unapproved price or result claim", "missing destination or attribution"]},
    {"treatment_id": "affiliate-decision-v1", "title": "Affiliate decision support", "audio_modes": ["narration", "music", "text-only"], "story_grammar": ["traveler decision", "useful comparison", "disclosed optional destination"], "hard_rejections": ["undisclosed commercial relationship", "merchant CTA before approval"]}
  ]
}
